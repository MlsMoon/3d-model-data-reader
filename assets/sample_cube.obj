# sample_cube.obj — 解析器测试夹具
# 覆盖：vt/vn、f v//vn、负数索引、多组(g)、usemtl、mtllib、s、行尾空白容错
# This file uses centimeters
mtllib cube.mtl

o Cube
g front
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0 0 1
v 1 0 1
v 1 1 1
v 0 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
usemtl CubeMat
s off
f 1/1/2 2/2/2 3/3/2 4/4/2
f 5//1 6//1 7//1 8//1
f -1//1 -2//1 -3//1 -4//1
g back
f 1/1/6 5/2/6 6/3/6 2/4/6
f 4//5 3//5 7//5 8//5
f 1/1/4 4/2/4 8/3/4 5/4/4
